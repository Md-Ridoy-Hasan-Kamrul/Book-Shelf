# BookVerse — copy to `.env` at repo root (Astro web + backend)

NODE_ENV=development

DATABASE_URL=postgresql://bookverse:bookverse@localhost:5432/bookverse
DIRECT_URL=postgresql://bookverse:bookverse@localhost:5432/bookverse
REDIS_URL=redis://localhost:6379

WEB_ORIGIN=http://localhost:4321
API_ORIGIN=http://localhost:4000
# Dev: use web origin so Vite proxies /api/auth and /me to :4000 (shared session cookie)
PUBLIC_API_URL=http://localhost:4321
API_INTERNAL_URL=http://localhost:4000

BETTER_AUTH_SECRET=local-dev-only-change-before-production-32chars
BETTER_AUTH_URL=http://localhost:4000

STORAGE_PROVIDER=local
EMAIL_PROVIDER=smtp
SMS_PROVIDER=console
PAYMENT_PROVIDER=mock
# TEST_CLOCK_ISO=2026-01-01T00:00:00.000Z
COURIER_PROVIDER=mock
MOCK_COURIER_WEBHOOK_SECRET=local-mock-courier-secret
# STEADFAST_WEBHOOK_BEARER_TOKEN=
LLM_PROVIDER=off
# Used only when FEATURE_MOOD_LLM=true and LLM_PROVIDER=mock|off (fallback)
LLM_MODEL=mock-mood-v1
SEARCH_PROVIDER=pg

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

FEATURE_RIDER=false
# P16 writer tools, beta-reader, AMA/live room (Socket.io), quote card UI
FEATURE_LIVE_EVENTS=false
# P15 publisher growth: sponsored campaigns, reprint demand, releases, offers
FEATURE_SPONSORED=false
FEATURE_MOOD_LLM=false
# P13 used-book marketplace + ISBN scanner (set true to enable routes/UI)
FEATURE_USED_BOOKS=false

# Vitest only — skip Postgres/Redis ping in unit tests
HEALTH_SKIP_INFRA=false

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@bookverse.local

UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
