---
const features = [
  {
    title: 'Astro pages',
    body: 'Routes, layouts, and static HTML live in .astro files. Most of the page never ships client JavaScript.',
  },
  {
    title: 'React islands',
    body: 'Interactive UI lives in .jsx files and hydrates with a client directive such as client:load.',
  },
  {
    title: 'Clear folders',
    body: 'pages, layouts, sections, and islands stay separate so the starter can grow without mixing concerns.',
  },
];
---

<section
  id="features"
  class="border-t border-line py-[clamp(3.5rem,8vw,6rem)]"
  aria-labelledby="features-title"
>
  <div class="mx-auto w-[min(100%-2rem,72rem)]">
    <p class="mb-3 font-display text-xs font-bold tracking-[0.14em] text-brand-600 uppercase">
      Features
    </p>
    <h2
      id="features-title"
      class="m-0 max-w-xl font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold tracking-tight text-ink-900"
    >
      What this setup is for
    </h2>
    <ul class="mt-8 grid list-none gap-4 p-0 min-[720px]:grid-cols-3">
      {
        features.map((feature) => (
          <li data-reveal class="rounded-[1.25rem] border border-line bg-paper p-5">
            <h3 class="m-0 font-display text-xl font-bold text-ink-900">{feature.title}</h3>
            <p class="m-0 mt-2 text-ink-700">{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
