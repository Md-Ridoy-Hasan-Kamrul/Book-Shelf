---
const steps = [
  {
    label: '01',
    title: 'Compose in Astro',
    body: 'Layouts wrap the page. Sections stay as static markup.',
  },
  {
    label: '02',
    title: 'Import React',
    body: 'Bring a .jsx component in the same way you import any other file.',
  },
  {
    label: '03',
    title: 'Add a directive',
    body: 'client:load hydrates the island in the browser. The rest of the page stays static.',
  },
];
---

<section
  id="how"
  class="border-t border-line bg-sand/60 py-[clamp(3.5rem,8vw,6rem)]"
  aria-labelledby="how-title"
>
  <div class="mx-auto w-[min(100%-2rem,72rem)]">
    <p class="mb-3 font-display text-xs font-bold tracking-[0.14em] text-brand-600 uppercase">
      How it works
    </p>
    <h2
      id="how-title"
      class="m-0 max-w-xl font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold tracking-tight text-ink-900"
    >
      Same pattern as the docs
    </h2>
    <p class="mt-3 max-w-xl text-lg text-ink-700">
      Astro owns the page shell. React owns the buy button. The button on the hero is that island.
    </p>
    <ol class="mt-8 grid list-none gap-4 p-0 min-[720px]:grid-cols-3">
      {
        steps.map((step) => (
          <li class="rounded-[1.25rem] border border-line bg-paper p-5">
            <p class="m-0 font-mono text-xs font-semibold tracking-wider text-brand-600">
              {step.label}
            </p>
            <h3 class="mt-2 mb-0 font-display text-xl font-bold text-ink-900">{step.title}</h3>
            <p class="m-0 mt-2 text-ink-700">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
