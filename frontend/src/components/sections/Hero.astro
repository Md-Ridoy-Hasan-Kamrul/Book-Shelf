<section
  id="top"
  class="relative overflow-hidden border-b border-line bg-cream py-[clamp(3rem,8vw,5.5rem)]"
  aria-labelledby="hero-title"
>
  <div
    class="pointer-events-none absolute -top-16 -left-10 h-64 w-64 rounded-full bg-brand-100/70 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-8 right-0 h-56 w-56 rounded-full bg-sun-100/80 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="bv-container relative">
    <p class="type-meta mb-3 font-display font-bold tracking-[0.14em] text-brand-600 uppercase">
      BookVerse
    </p>
    <h1 id="hero-title" class="type-hero m-0 max-w-3xl text-ink-900">
      বাংলাদেশের বইয়ের ঘর: পড়ুন, শেয়ার করুন, কিনুন
    </h1>
    <p class="type-lead mt-4 max-w-xl text-ink-700">
      নতুন ও পুরনো বই, লেখক ও প্রকাশক এক জায়গায়। মুড দিয়ে আবিষ্কার করুন, কমিউনিটিতে যোগ দিন।
    </p>
    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a
        href="/mood"
        class="inline-flex min-h-11 items-center rounded-(--radius-card) bg-cta-500 px-5 text-sm font-semibold text-ink-900 no-underline hover:bg-cta-700 hover:text-paper"
      >
        মুড দিয়ে খুঁজুন
      </a>
      <a
        href="/search"
        class="inline-flex min-h-11 items-center rounded-(--radius-card) border border-line bg-paper px-5 text-sm font-semibold text-ink-900 no-underline hover:bg-sand"
      >
        সার্চ
      </a>
    </div>
  </div>
</section>
