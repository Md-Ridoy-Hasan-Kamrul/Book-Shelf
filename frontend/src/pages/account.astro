---
import Base from '../layouts/Base.astro';
import Island from '../components/islands/Island.tsx';
import AccountPanel from '../components/islands/AccountPanel.tsx';
import { getFeatureFlags } from '../env';
import { fetchMe } from '../lib/session';

const flags = getFeatureFlags();
const u = await fetchMe(Astro.request.headers.get('cookie') ?? '');
if (!u) {
  return Astro.redirect(`/login?next=${encodeURIComponent('/account')}`);
}
---

<Base title="Profile">
  <main id="main" class="py-10">
    <div class="mx-auto w-[min(100%-1.5rem,40rem)] mm:w-[min(100%-2rem,40rem)]">
      <h1 class="type-page m-0 text-ink-900">Profile</h1>
      <p class="type-lead mt-2 text-ink-500">Account, roles, and shortcuts.</p>
      <div class="mt-8">
        <Island client:load>
          <AccountPanel
            name={u.name}
            email={u.email}
            role={u.role}
            usedBooks={flags.usedBooks}
            sponsored={flags.sponsored}
            liveEvents={flags.liveEvents}
          />
        </Island>
      </div>
    </div>
  </main>
</Base>
