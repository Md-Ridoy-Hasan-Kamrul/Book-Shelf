---
import Base from '../../layouts/Base.astro';
---

<Base title="Privacy · গোপনীয়তা">
  <main id="main" class="py-10">
    <article class="mx-auto w-[min(100%-2rem,48rem)]">
      <p class="text-xs font-bold text-ink-500 uppercase">Draft · unpublished until hosting</p>
      <h1 class="font-display text-3xl font-bold text-ink-900">Privacy Policy / গোপনীয়তা নীতি</h1>

      <h2 class="mt-8 font-display text-xl font-bold">English</h2>
      <p class="text-ink-700">
        We process account data (email, phone when provided), orders, and optional mood logs only
        with consent. We do not sell personal data. Sponsored ads target genre and follower
        relationship only — no invasive profiling. Payment details are handled by payment providers.
      </p>

      <h2 class="mt-8 font-display text-xl font-bold">বাংলা</h2>
      <p class="text-ink-700">
        আমরা অ্যাকাউন্ট ডেটা (ইমেইল, ফোন), অর্ডার এবং শুধু সম্মতিতে মুড লগ প্রক্রিয়া করি। ব্যক্তিগত
        তথ্য বিক্রি করি না। স্পন্সরড বিজ্ঞাপন শুধু জেনার ও ফলোয়ার সম্পর্ক ব্যবহার করে। পেমেন্ট
        প্রদানকারীদের মাধ্যমে পেমেন্ট হয়।
      </p>
    </article>
  </main>
</Base>
