---
import Base from '../../layouts/Base.astro';
import SellerDashboard from '../../components/islands/SellerDashboard.tsx';
import { fetchMe } from '../../lib/session';
import { isSellerRole, SELLER_ROLE_UI } from '../../lib/sellerRoleUi';

const me = await fetchMe(Astro.request.headers.get('cookie') ?? '');
if (!me) return Astro.redirect('/login?next=/seller/dashboard');
if (!isSellerRole(me.role)) return Astro.redirect('/');

const ui = SELLER_ROLE_UI[me.role];
---

<Base title={ui.heading} description={ui.blurb}>
  <main id="main" class="mx-auto w-[min(100%-2rem,48rem)] py-8">
    <header
      class="rounded-[var(--radius-card)] border border-line bg-paper px-4 py-4 shadow-[var(--shadow-warm)]"
    >
      <span
        class={`inline-flex rounded-[var(--radius-card)] px-2.5 py-1 text-xs font-bold ${ui.badgeClass}`}
        >{ui.badge}</span
      >
      <h1 class="mt-2 font-display text-2xl font-bold text-ink-900">{ui.heading}</h1>
      <p class="m-0 mt-1 text-sm text-ink-500">{me.displayName ?? me.name} · {ui.blurb}</p>
    </header>
    <div class="mt-6">
      <SellerDashboard client:load role={me.role} />
    </div>
  </main>
</Base>
