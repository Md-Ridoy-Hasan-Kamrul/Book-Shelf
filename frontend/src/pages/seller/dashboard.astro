---
import Base from '../../layouts/Base.astro';
import SellerDashboard from '../../components/islands/SellerDashboard.tsx';
import { fetchMe } from '../../lib/session';

const me = await fetchMe(Astro.request.headers.get('cookie') ?? '');
if (!me) return Astro.redirect('/login?next=/seller/dashboard');
const sellerRoles = ['PUBLISHER', 'VENDOR', 'WRITER'];
if (!sellerRoles.includes(me.role)) return Astro.redirect('/');
---

<Base title="Seller dashboard" description="Manage inventory, orders, and earnings">
  <main id="main" class="mx-auto w-[min(100%-2rem,48rem)] py-8">
    <h1 class="font-display text-2xl font-bold text-ink-900">Seller dashboard</h1>
    <p class="text-sm text-ink-500">{me.displayName ?? me.name}</p>
    <div class="mt-6">
      <SellerDashboard client:load />
    </div>
  </main>
</Base>
