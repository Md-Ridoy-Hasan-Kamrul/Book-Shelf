---
import Base from '../../layouts/Base.astro';
import PublisherGrowthDashboard from '../../components/islands/PublisherGrowthDashboard.tsx';
---

<Base title="Publisher growth">
  <main id="main" class="py-10">
    <div class="mx-auto w-[min(100%-2rem,72rem)]">
      <h1 class="m-0 font-display text-3xl font-bold text-ink-900">Publisher growth</h1>
      <p class="mt-2 text-ink-500">
        Sponsored campaigns, reprint demand, and offers — requires FEATURE_SPONSORED.
      </p>
      <div class="mt-8">
        <PublisherGrowthDashboard client:load />
      </div>
    </div>
  </main>
</Base>
