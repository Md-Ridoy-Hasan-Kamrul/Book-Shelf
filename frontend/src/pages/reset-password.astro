---
import Base from '../layouts/Base.astro';
import AuthForm from '../components/islands/AuthForm.tsx';

const token = Astro.url.searchParams.get('token') ?? undefined;
---

<Base title="New password">
  <main id="main" class="py-12">
    <div class="mx-auto w-[min(100%-2rem,28rem)]">
      <h1 class="m-0 text-center font-display text-3xl font-bold text-ink-900">
        Choose a new password
      </h1>
      <div class="mt-8">
        <AuthForm client:load mode="reset" resetToken={token} />
      </div>
    </div>
  </main>
</Base>
