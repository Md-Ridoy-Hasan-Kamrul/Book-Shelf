---
import Base from '../layouts/Base.astro';
import AuthForm from '../components/islands/AuthForm.tsx';
---

<Base title="Verify email">
  <main id="main" class="py-12">
    <div class="mx-auto w-[min(100%-2rem,28rem)]">
      <h1 class="m-0 text-center font-display text-3xl font-bold text-ink-900">Verify email</h1>
      <p class="mt-2 text-center text-sm text-ink-500">
        Click the link in Mailpit or resend below.
      </p>
      <div class="mt-8">
        <AuthForm client:load mode="verify-email" />
      </div>
    </div>
  </main>
</Base>
