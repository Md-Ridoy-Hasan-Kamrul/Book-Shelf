---
import Base from '../layouts/Base.astro';
import BookshelfBoard from '../components/islands/BookshelfBoard.tsx';
---

<Base title="My bookshelf" description="Reading shelf and yearly goal">
  <main id="main" class="bv-container py-6 tab:py-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="type-page m-0 text-ink-900">Bookshelf</h1>
        <p class="type-ui m-0 mt-1 text-ink-500">Want · Reading · Read · Paused</p>
      </div>
      <a href="/points" class="text-sm font-semibold text-brand-700 underline">Points history</a>
    </div>
    <BookshelfBoard client:load />
  </main>
</Base>
