---
import Base from '../../layouts/Base.astro';
import { fetchBookBySlug } from '../../lib/catalogApi';
import AddToCartButton from '../../components/islands/AddToCartButton.tsx';
import WishlistButton from '../../components/islands/WishlistButton.tsx';
import BookReviews from '../../components/islands/BookReviews.tsx';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/');
}
const book = await fetchBookBySlug(slug);
if (!book) {
  return Astro.redirect('/search');
}

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Book',
      name: book.title,
      author: { '@type': 'Person', name: book.author },
      inLanguage: book.language,
      isbn: book.isbn ?? undefined,
      image: book.coverUrl ?? undefined,
    },
    {
      '@type': 'Product',
      name: book.title,
      description: book.description.slice(0, 500),
      image: book.coverUrl ?? undefined,
      brand: book.publisherName,
      offers: book.listings.map((l) => ({
        '@type': 'Offer',
        price: l.price,
        priceCurrency: 'BDT',
        itemCondition:
          l.condition === 'NEW'
            ? 'https://schema.org/NewCondition'
            : 'https://schema.org/UsedCondition',
        availability: l.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
        {
          '@type': 'ListItem',
          position: 2,
          name: book.genreName,
          item: `/category/${book.genreSlug}`,
        },
        { '@type': 'ListItem', position: 3, name: book.title, item: canonical },
      ],
    },
  ],
};

Astro.response.headers.set('Cache-Control', 'public, max-age=120, stale-while-revalidate=300');
---

<Base
  title={book.title}
  description={book.description.slice(0, 160)}
  ogImage={book.coverUrl ?? undefined}
  jsonLd={jsonLd}
>
  <main id="main" class="py-10">
    <div class="mx-auto grid w-[min(100%-2rem,72rem)] gap-8 min-[900px]:grid-cols-[240px_1fr]">
      <div
        class="rounded-[var(--radius-card)] border border-line bg-sand aspect-[3/4] overflow-hidden"
      >
        {
          book.coverUrl ? (
            <img src={book.coverUrl} alt="" class="h-full w-full object-cover" loading="eager" />
          ) : null
        }
      </div>
      <div>
        <p class="text-sm font-semibold text-brand-700">
          <a href={`/category/${book.genreSlug}`}>{book.genreNameBn}</a>
        </p>
        <h1 class="m-0 font-display text-3xl font-bold text-ink-900">{book.titleBn}</h1>
        <p class="mt-1 text-lg text-ink-700">{book.title}</p>
        <p class="mt-2 text-ink-500">
          <a href={`/author/${encodeURIComponent(book.author)}`}>{book.author}</a>
          {
            book.publisherSlug && (
              <>
                {' '}
                · <a href={`/publisher/${book.publisherSlug}`}>{book.publisherName}</a>
              </>
            )
          }
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <WishlistButton client:load bookId={book.id} />
        </div>
        <p class="mt-6 max-w-2xl text-ink-700">{book.descriptionBn ?? book.description}</p>

        <section class="mt-8" aria-labelledby="listings-title">
          <h2 id="listings-title" class="font-display text-xl font-bold text-ink-900">Listings</h2>
          <ul class="mt-4 list-none space-y-3 p-0">
            {
              book.listings.map((l) => (
                <li class="flex flex-wrap items-center justify-between gap-3 rounded-[var(--radius-card)] border border-line bg-paper p-4">
                  <div>
                    <p class="m-0 font-semibold text-ink-900">
                      {l.condition} · {l.sellerType}
                    </p>
                    <p class="m-0 text-sm text-ink-500">{l.sellerName}</p>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="font-semibold text-ink-900">৳{l.price}</span>
                    <AddToCartButton
                      client:load
                      listingId={l.id}
                      title={book.title}
                      disabled={l.stock <= 0}
                    />
                  </div>
                </li>
              ))
            }
          </ul>
        </section>

        {
          book.lookInsidePages?.length ? (
            <section class="mt-10" aria-labelledby="look-inside">
              <h2 id="look-inside" class="font-display text-xl font-bold text-ink-900">
                Look inside
              </h2>
              <div class="mt-3 grid grid-cols-2 gap-2 min-[520px]:grid-cols-3">
                {book.lookInsidePages.map((src) => (
                  <img
                    src={src}
                    alt=""
                    class="rounded-lg border border-line bg-paper"
                    loading="lazy"
                  />
                ))}
              </div>
            </section>
          ) : null
        }
      </div>
    </div>
    <div class="mx-auto w-[min(100%-2rem,72rem)]">
      <BookReviews client:load bookId={book.id} />
    </div>
  </main>
</Base>
