---
import Base from '../../../layouts/Base.astro';
import PdfBookReader from '../../../components/islands/PdfBookReader.tsx';
import { fetchBookBySlug } from '../../../lib/catalogApi';
import { bookPdfExists } from '../../../lib/bookPdf';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/');
}

const book = await fetchBookBySlug(slug);
if (!book) {
  return Astro.redirect('/search');
}

const canReadOnline = Boolean(book.hasReadablePdf) || (await bookPdfExists(book.slug));
if (!canReadOnline) {
  return Astro.redirect(`/books/${slug}`);
}

const heading = book.titleBn || book.title;
---

<Base title={`Read: ${heading}`} description={`Read online: ${heading} (download disabled).`}>
  <main id="main" class="bv-container py-2 tab:py-6">
    <header class="mb-2 flex min-w-0 items-baseline justify-between gap-2 tab:mb-4">
      <div class="min-w-0">
        <p class="type-meta m-0 font-semibold text-brand-700">Read online</p>
        <h1
          class="type-section m-0 mt-0.5 truncate text-base text-ink-900 tab:mt-1 tab:text-[length:inherit]"
        >
          {heading}
        </h1>
        <p class="m-0 hidden text-sm text-ink-500 tab:mt-0.5 tab:block">{book.author}</p>
      </div>
      <p class="m-0 hidden shrink-0 text-xs text-ink-500 tab:block">Zoom · pages · no download</p>
    </header>
    <PdfBookReader client:load slug={book.slug} title={heading} />
  </main>
</Base>
