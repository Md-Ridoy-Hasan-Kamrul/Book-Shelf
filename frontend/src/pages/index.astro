---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import ScrollReveal from '../components/islands/ScrollReveal.tsx';
import MoodPicker from '../components/islands/MoodPicker.tsx';
import RecommendRail from '../components/islands/RecommendRail.tsx';
import HomeBrowseStrip from '../components/islands/HomeBrowseStrip.tsx';
---

<Base title="BookVerse: Home">
  <ScrollReveal client:load />
  <main id="main">
    <Hero />
    <section class="py-10" aria-label="Mood discovery">
      <div class="bv-container grid min-w-0 max-w-full gap-6 tab:gap-8">
        <MoodPicker client:load />
        <RecommendRail client:load />
      </div>
    </section>
    <HomeBrowseStrip client:load />
  </main>
</Base>
