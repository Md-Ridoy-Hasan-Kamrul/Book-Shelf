---
import Base from '../layouts/Base.astro';
import MoodResults from '../components/islands/MoodResults.tsx';
import { moodEnumSchema } from '@bookverse/shared';

const raw = Astro.url.searchParams.get('mood') ?? 'curious';
const parsed = moodEnumSchema.safeParse(raw);
const mood = parsed.success ? parsed.data : 'curious';
---

<Base title={`Mood · ${mood}`}>
  <main id="main" class="py-10">
    <div class="mx-auto w-[min(100%-2rem,72rem)]">
      <h1 class="m-0 font-display text-3xl font-bold text-ink-900">Mood results</h1>
      <p class="mt-2 max-w-2xl text-ink-500">
        Soft mood chips help you browse — these books may match your mood. We never diagnose
        emotions.
      </p>
      <div class="mt-8">
        <MoodResults client:load initialMood={mood} />
      </div>
    </div>
  </main>
</Base>
