---
import Base from '../layouts/Base.astro';
import DesignGuide from '../components/islands/DesignGuide.tsx';

if (!import.meta.env.DEV) {
  return Astro.redirect('/');
}
---

<Base title="Design system" description="BookVerse Fresh & Human: dev style guide.">
  <main id="main" class="py-10">
    <div class="mx-auto w-[min(100%-2rem,72rem)]">
      <p class="mb-2 font-display text-xs font-bold tracking-[0.14em] text-brand-600 uppercase">
        P2 · Design
      </p>
      <h1 class="m-0 font-display text-4xl font-bold text-ink-900">Fresh &amp; Human shell</h1>
      <p class="mt-3 max-w-2xl text-lg text-ink-700">
        ক্রিম ব্যাকগ্রাউন্ড, সাদা কার্ড, নীল বিশ্বাস, সবুজ তাজা, কমলা CTA (max ২): আপনি নিজে দেখে
        জিজ্ঞেস করুন:
        <strong>তাজা, শান্ত, বিশ্বাসযোগ্য?</strong>
      </p>
      <div class="mt-8">
        <DesignGuide client:load />
      </div>
    </div>
  </main>
</Base>
