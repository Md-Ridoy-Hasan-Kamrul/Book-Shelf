---
/**
 * Mock-only: set bv_mock_role cookie server-side, then redirect.
 * Works without React/JS: fixes "login buttons do nothing" when island fails.
 */
import { useMockData } from '../lib/mockMode';
import { postLoginPath, safeNextPath } from '../lib/postLogin';

if (!useMockData()) {
  return Astro.redirect('/login');
}

const raw = (Astro.url.searchParams.get('role') ?? 'USER').toUpperCase();
const role = ['ADMIN', 'VENDOR', 'PUBLISHER', 'WRITER', 'USER', 'MODERATOR'].includes(raw)
  ? raw
  : 'USER';
const go = safeNextPath(Astro.url.searchParams.get('next')) ?? postLoginPath(role);

Astro.cookies.set('bv_mock_role', role, {
  path: '/',
  maxAge: 60 * 60 * 24 * 30,
  sameSite: 'lax',
  httpOnly: false,
});

return Astro.redirect(go);
---
