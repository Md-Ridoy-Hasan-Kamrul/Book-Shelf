---
import Base from '../../layouts/Base.astro';
import Island from '../../components/islands/Island.tsx';
import FollowButton from '../../components/islands/FollowButton.tsx';
import { z } from 'zod';
import { getWebEnv } from '../../env';
import { useMockData } from '../../lib/mockMode';
import { mockWriter } from '../../lib/mockCatalog';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const profileSchema = z.object({
  success: z.literal(true),
  data: z.object({
    userId: z.string(),
    penName: z.string(),
    slug: z.string(),
    bio: z.string().nullable(),
    verified: z.boolean(),
    displayName: z.string(),
    books: z.array(
      z.object({
        id: z.string(),
        slug: z.string(),
        title: z.string(),
        titleBn: z.string(),
      }),
    ),
    posts: z.array(
      z.object({
        id: z.string(),
        type: z.string(),
        body: z.string(),
        createdAt: z.string(),
      }),
    ),
  }),
});

let profile: z.infer<typeof profileSchema>['data'] | null = null;
if (useMockData()) {
  profile = mockWriter(slug);
} else {
  try {
    const base = getWebEnv().PUBLIC_API_URL.replace(/\/$/, '');
    const res = await fetch(`${base}/writer/profiles/${slug}`);
    if (res.ok) {
      const json = profileSchema.parse(await res.json());
      profile = json.data;
    }
  } catch {
    profile = null;
  }
}

if (!profile) {
  return Astro.redirect('/');
}
---

<Base title={`${profile.penName} · Writer`}>
  <main id="main" class="py-10">
    <div class="mx-auto w-[min(100%-2rem,72rem)]">
      <p class="m-0 text-xs font-bold tracking-wide text-brand-600 uppercase">
        Writer{profile.verified ? ' · verified' : ''}
      </p>
      <h1 class="m-0 mt-1 font-display text-3xl font-bold text-ink-900">{profile.penName}</h1>
      <p class="mt-2 max-w-2xl text-ink-700">{profile.bio ?? 'No bio yet.'}</p>
      <div class="mt-4">
        <Island client:load>
          <FollowButton userId={profile.userId} />
        </Island>
      </div>

      <section class="mt-10" aria-labelledby="writer-books">
        <h2 id="writer-books" class="font-display text-xl font-bold text-ink-900">Books</h2>
        <ul class="mt-4 grid list-none gap-3 p-0 min-[720px]:grid-cols-3">
          {
            profile.books.map((b) => (
              <li>
                <a
                  href={`/books/${b.slug}`}
                  class="block rounded-(--radius-card) border border-line bg-paper p-3 no-underline hover:bg-sand"
                >
                  <p class="m-0 font-display font-bold text-ink-900">{b.titleBn}</p>
                  <p class="m-0 text-sm text-ink-500">{b.title}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-10" aria-labelledby="writer-posts">
        <h2 id="writer-posts" class="font-display text-xl font-bold text-ink-900">
          Blog &amp; announcements
        </h2>
        <ul class="mt-4 list-none space-y-3 p-0">
          {
            profile.posts.map((p) => (
              <li class="rounded-(--radius-card) border border-line bg-paper p-4">
                <p class="m-0 text-xs font-bold text-ink-500 uppercase">{p.type}</p>
                <p class="mt-2 whitespace-pre-wrap text-ink-900">{p.body}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</Base>
