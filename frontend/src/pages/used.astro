---
import Base from '../layouts/Base.astro';
import UsedNearMe from '../components/islands/UsedNearMe.tsx';
---

<Base title="Used books near me" description="Browse used books by district">
  <main id="main" class="mx-auto w-[min(100%-2rem,40rem)] py-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="font-display text-2xl font-bold text-ink-900">Used near me</h1>
        <p class="text-sm text-ink-500">Filter by district / area</p>
      </div>
      <a href="/sell/used" class="text-sm font-semibold text-brand-700 underline">Sell yours</a>
    </div>
    <UsedNearMe client:load />
  </main>
</Base>
