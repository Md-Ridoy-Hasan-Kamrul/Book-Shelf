---
import '../styles/global.css';
import '@fontsource/hind-siliguri/400.css';
import '@fontsource/hind-siliguri/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import Navbar from '../components/layout/Navbar.jsx';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'BookVerse',
	description = 'বই কেনাবেচা ও সোশ্যাল রিডিং — Astro + React starter.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="bn">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<title>{title}</title>
	</head>
	<body class="bg-cream text-ink-900">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-[var(--radius-card)] focus:bg-brand-600 focus:px-3 focus:py-2 focus:text-paper"
		>
			Skip to content
		</a>
		<Navbar client:load />
		<slot />
	</body>
</html>
