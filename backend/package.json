{
  "name": "@bookverse/api",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "worker": "tsx watch --env-file-if-exists=../.env src/worker.ts",
    "worker:once": "tsx --env-file-if-exists=../.env src/worker.ts",
    "build": "prisma generate && tsup",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "tsx --env-file-if-exists=../.env prisma/run-prisma.ts generate",
    "db:validate": "tsx --env-file-if-exists=../.env prisma/run-prisma.ts validate",
    "db:migrate": "tsx --env-file-if-exists=../.env prisma/run-prisma.ts migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../.env prisma/seed.ts",
    "db:explain": "tsx --env-file-if-exists=../.env prisma/explain-indexes.ts",
    "db:studio": "prisma studio",
    "db:seed:bench": "tsx --env-file-if-exists=../.env prisma/seed-bench.ts",
    "bench:search": "tsx --env-file-if-exists=../.env scripts/benchmark-search.ts",
    "reconcile": "tsx --env-file-if-exists=../.env scripts/reconcile.ts",
    "verify:points": "tsx --env-file-if-exists=../.env scripts/verify-points-balance.ts"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=../.env prisma/seed.ts"
  },
  "dependencies": {
    "@bookverse/shared": "workspace:*",
    "@prisma/client": "^6.19.0",
    "better-auth": "^1.7.7",
    "bullmq": "5.58.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "ioredis": "5.8.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "redis": "^5.8.2",
    "sharp": "0.35.5",
    "tslib": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.19.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
