{
  "name": "bookverse",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "prepare": "husky",
    "dev": "node api.js && pnpm --filter @bookverse/shared build && pnpm --filter @bookverse/web dev",
    "dev:stack": "pnpm --filter @bookverse/shared build && node scripts/check-infra.mjs && node scripts/run-parallel.mjs dev:web dev:api dev:worker",
    "dev:web": "pnpm --filter @bookverse/web dev",
    "dev:api": "pnpm --filter @bookverse/api dev",
    "dev:backend": "pnpm --filter @bookverse/api dev",
    "dev:worker": "pnpm --filter @bookverse/api worker",
    "build": "node api.js && pnpm --filter @bookverse/shared build && pnpm --filter @bookverse/web build && pnpm --filter @bookverse/api build",
    "lint": "eslint frontend/src backend/src packages/shared/src",
    "typecheck": "pnpm --filter @bookverse/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @bookverse/shared build && pnpm -r test",
    "test:watch": "pnpm --filter @bookverse/shared build && node scripts/run-parallel.mjs test:watch:web test:watch:api",
    "test:watch:web": "pnpm --filter @bookverse/web test:watch",
    "test:watch:api": "pnpm --filter @bookverse/api test:watch",
    "test:e2e": "pnpm --filter @bookverse/web test:e2e",
    "test:e2e:ui": "pnpm --filter @bookverse/web test:e2e:ui",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:validate": "pnpm --filter @bookverse/api db:validate",
    "db:migrate": "pnpm --filter @bookverse/api db:migrate",
    "db:seed": "pnpm --filter @bookverse/api db:seed",
    "db:explain": "pnpm --filter @bookverse/api db:explain",
    "db:seed:bench": "pnpm --filter @bookverse/api db:seed:bench",
    "bench:search": "pnpm --filter @bookverse/api bench:search",
    "db:studio": "pnpm --filter @bookverse/api db:studio",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "load:k6": "k6 run k6/browse-search-checkout.js",
    "sim:ipn": "node scripts/sim-ipn.mjs",
    "reconcile": "pnpm --filter @bookverse/api reconcile",
    "sim:courier": "node scripts/sim-courier.mjs",
    "bench:feed": "node scripts/bench-feed.mjs",
    "verify:points": "pnpm --filter @bookverse/api verify:points"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx,astro,css,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.46.0"
  },
  "allowScripts": {
    "esbuild": true,
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  }
}
