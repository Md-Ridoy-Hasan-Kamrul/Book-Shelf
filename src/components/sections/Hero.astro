---
import BuyButton from '../islands/BuyButton.jsx';
---

<section id="top" class="py-[clamp(4rem,10vw,7rem)]" aria-labelledby="hero-title">
	<div class="mx-auto grid w-[min(100%-2rem,72rem)] gap-8 min-[900px]:grid-cols-[1.2fr_0.8fr] min-[900px]:items-center">
		<div>
			<p class="mb-3 font-display text-xs font-bold tracking-[0.14em] text-sea uppercase">
				Astro + React
			</p>
			<h1
				id="hero-title"
				class="m-0 font-display text-[clamp(2.25rem,6vw,4.25rem)] leading-[1.05] font-bold tracking-tight text-ink"
			>
				Static pages. Interactive islands.
			</h1>
			<p class="mt-4 max-w-xl text-lg text-ink-soft">
				Build the shell in Astro. Hydrate a React component only where someone needs to click.
			</p>
			<div class="mt-7">
				<BuyButton id="starter-kit" client:load />
			</div>
		</div>
		<div class="rounded-[1.25rem] border border-line bg-paper p-6 shadow-[0_18px_40px_rgb(20_33_43/0.06)]">
			<p class="m-0 font-mono text-xs tracking-wide text-sea uppercase">Page pattern</p>
			<pre class="mt-3 overflow-x-auto text-sm leading-relaxed text-ink"><code>{`import BuyButton from '../components/BuyButton.jsx';

<BuyButton id={product.id} client:load />`}</code></pre>
		</div>
	</div>
</section>
